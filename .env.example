# Environment Variables
GEMINI_API_KEY=

# Reaction GIFs in multiplayer. Either provider is optional: with neither set,
# the reaction picker falls back to a built-in animated pack.
#
# These are inlined into the client bundle (Vite only exposes VITE_* vars), so
# treat them as public keys. Giphy and Tenor both issue them free.
VITE_GIPHY_API_KEY=
VITE_TENOR_API_KEY=
