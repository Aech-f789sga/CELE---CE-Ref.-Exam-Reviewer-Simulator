rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Case-insensitive on purpose. The client compares with
    // `email.trim().toLowerCase() === DESIGNATED_ADMIN_EMAIL.toLowerCase()`, so
    // an exact `==` here would let an account whose address differs only in
    // capitalisation into the panel while Firestore still refused every write
    // -- a denial that looks exactly like a missing rule.
    function isDesignatedAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'derrickdarrack@gmail.com'
      );
    }

    // Who counts as ADMIN. The client decides the same question in
    // AuthContext (`isUserAdmin(email) || profile.role === 'admin'`), and the
    // two MUST agree: if the client lets someone into the admin panel while
    // this function disagrees, every write they make is silently refused and
    // the panel looks broken. That is exactly what happened to the By-topics
    // switch, so the profile role is accepted here too.
    //
    // Accepting it is safe, because `users` below only lets a document be
    // written with role 'admin' by the designated address or by an existing
    // admin -- a normal account cannot promote itself through this door.
    function isProfileAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return isSignedIn() && (
        isDesignatedAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isProfileAdmin()
      );
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             data.role in ['admin', 'user'] &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidExamAttempt(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.subject in ['MSTC', 'HPGE', 'PSAD'] &&
             data.year is number &&
             data.score is number &&
             data.totalQuestions is number &&
             data.ratingPercentage is number &&
             data.completedAt is string && data.completedAt.size() <= 64;
    }

    function isValidAnnouncement(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 2000 &&
             data.authorEmail is string && data.authorEmail.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.isActive is bool;
    }

    function isValidPresence(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.lastSeenAt is string && data.lastSeenAt.size() <= 64 &&
             data.isOnline is bool;
    }

    function isValidFeatureInteraction(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.featureId is string && data.featureId.size() <= 128 &&
             data.durationSeconds is number &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming()) && (
        (incoming().role == 'user' && incoming().email != 'derrickdarrack@gmail.com') ||
        (incoming().role == 'admin' && incoming().email == 'derrickdarrack@gmail.com') ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Admins marker collection
    match /admins/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && (
        incoming().email == 'derrickdarrack@gmail.com' || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Exam attempts collection
    match /examAttempts/{attemptId} {
      allow get, list: if true;
      allow create: if isValidId(attemptId) && isValidExamAttempt(incoming());
      allow update, delete: if isAdmin();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isValidId(announcementId) && isValidAnnouncement(incoming());
      allow delete: if true;
    }

    // Reviewee Requests & Messages to Admin
    match /userMessages/{messageId} {
      allow create: if isValidId(messageId) &&
                    incoming().senderName is string && incoming().senderName.size() <= 128 &&
                    incoming().message is string && incoming().message.size() <= 5000 &&
                    incoming().createdAt is string;
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Item reports filed from inside a sitting or a drill.
    //
    // A signed-in reviewee may file one, and may file nothing else: the shape
    // is checked here so a tampered client cannot use the collection as free
    // storage, and `status` must start at 'open' so nobody can file a report
    // that is already marked fixed. Reading and moving the status is the
    // admin's alone — a reporter does not need to see other people's reports,
    // and the panel is the only place the decision is made.
    match /questionReports/{reportId} {
      allow create: if isSignedIn() &&
                    isValidId(reportId) &&
                    incoming().questionId is string && incoming().questionId.size() <= 128 &&
                    incoming().reporterName is string && incoming().reporterName.size() <= 128 &&
                    incoming().note is string && incoming().note.size() <= 2000 &&
                    incoming().questionText is string && incoming().questionText.size() <= 20000 &&
                    incoming().reason is string && incoming().reason.size() <= 64 &&
                    incoming().createdAt is string &&
                    incoming().status == 'open';
      allow read, update, delete: if isAdmin();
    }

    // User online presence and active feature tracking
    match /userPresence/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidPresence(incoming());
      allow delete: if isAdmin();
    }

    // Feature interactions log for admin usage and analytics
    match /featureInteractions/{interactionId} {
      allow read: if true;
      allow create: if isValidId(interactionId) && isValidFeatureInteraction(incoming());
      allow update, delete: if isAdmin();
    }

    // App-wide switches, e.g. whether the By-topics exam is open to reviewees.
    // Read is public on purpose: the client has to know whether to show the
    // entry before anyone signs in, and the value is a single boolean. Writing
    // is the admin's alone, so a tampered client cannot open the mode for
    // itself -- it can only lie to itself about a value that grants it UI.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live rooms — the shared exam two or more people sit at once.
    //
    // The four-character code **is** the document id, so "knowing the code" and
    // "knowing the document" are the same fact. That is what makes a private
    // room private: `get` is open to any signed-in account, and the secret is
    // the code rather than a read rule. `list` is the one thing that must not
    // leak, so it is restricted to public rooms — and because Firestore rejects
    // a query the rules cannot prove, the client's discovery query has to
    // filter on `visibility` for this to be usable at all.
    //
    // Phases are the host's to move. A player may write only their own
    // `players/{uid}` document and their own vote, which is what stops a
    // tampered client from answering on someone else's behalf — the one form of
    // cheating that would be invisible in the results.
    function isValidRoomCode(code) {
      return code is string && code.size() == 4 && code.matches('^[A-HJKMNP-Z346789]{4}$');
    }

    match /liveRooms/{roomCode} {
      allow get: if isSignedIn();
      // Two provable queries, not one: the public browser filters on
      // `visibility`, and the host's stale-room sweep filters on `hostId`. A
      // rule naming only `visibility` would make the sweep fail with
      // permission-denied — silently, because housekeeping swallows its own
      // errors — and abandoned rooms would accumulate for ever.
      allow list: if isSignedIn() &&
                  (resource.data.visibility == 'public' ||
                   resource.data.hostId == request.auth.uid);
      allow create: if isSignedIn() &&
                    isValidRoomCode(roomCode) &&
                    incoming().hostId == request.auth.uid &&
                    incoming().phase == 'lobby' &&
                    incoming().mode in ['versus', 'coop'] &&
                    incoming().visibility in ['public', 'private'] &&
                    incoming().questionIds is list &&
                    incoming().questionIds.size() == 0;
      allow update, delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      function amHost(code) {
        return isSignedIn() &&
          get(/databases/$(database)/documents/liveRooms/$(code)).data.hostId == request.auth.uid;
      }

      function isPlayer(code) {
        return isSignedIn() &&
          exists(/databases/$(database)/documents/liveRooms/$(code)/players/$(request.auth.uid));
      }

      // The roster. Anyone in the room may read it — the lobby and the results
      // screen both show who is here — but only you may write your own row, and
      // only the host may remove someone else's.
      match /players/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isSignedIn() && (request.auth.uid == uid || amHost(roomCode));
      }

      // Votes, one document per item, keyed by uid. A player must be in the room
      // to write one; there is no delete, because unanswering is not a thing the
      // exam allows and a cleared vote would silently change a co-op majority.
      match /answers/{questionId} {
        allow read: if isSignedIn();
        allow create, update: if isPlayer(roomCode);
      }

      // GIF reactions. Read by everyone in the room, written only under your own
      // uid, and pruned by the host — the only party who can delete, since a
      // reaction someone else could remove is a reaction that can be erased
      // mid-laugh.
      match /reactions/{reactionId} {
        allow read: if isSignedIn();
        allow create: if isPlayer(roomCode) && incoming().uid == request.auth.uid;
        allow delete: if amHost(roomCode);
      }
    }
  }
}
