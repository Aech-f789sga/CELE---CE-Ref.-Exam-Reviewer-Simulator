rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isDesignatedAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'derrickdarrack@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isDesignatedAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             data.role in ['admin', 'user'] &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidExamAttempt(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.subject in ['MSTC', 'HPGE', 'PSAD'] &&
             data.year is number &&
             data.score is number &&
             data.totalQuestions is number &&
             data.ratingPercentage is number &&
             data.completedAt is string && data.completedAt.size() <= 64;
    }

    function isValidAnnouncement(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 2000 &&
             data.authorEmail is string && data.authorEmail.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.isActive is bool;
    }

    function isValidPresence(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.lastSeenAt is string && data.lastSeenAt.size() <= 64 &&
             data.isOnline is bool;
    }

    function isValidFeatureInteraction(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.featureId is string && data.featureId.size() <= 128 &&
             data.durationSeconds is number &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming()) && (
        (incoming().role == 'user' && incoming().email != 'derrickdarrack@gmail.com') ||
        (incoming().role == 'admin' && incoming().email == 'derrickdarrack@gmail.com') ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Admins marker collection
    match /admins/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && (
        incoming().email == 'derrickdarrack@gmail.com' || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Exam attempts collection
    match /examAttempts/{attemptId} {
      allow get, list: if true;
      allow create: if isValidId(attemptId) && isValidExamAttempt(incoming());
      allow update, delete: if isAdmin();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isValidId(announcementId) && isValidAnnouncement(incoming());
      allow delete: if true;
    }

    // Reviewee Requests & Messages to Admin
    match /userMessages/{messageId} {
      allow create: if isValidId(messageId) &&
                    incoming().senderName is string && incoming().senderName.size() <= 128 &&
                    incoming().message is string && incoming().message.size() <= 5000 &&
                    incoming().createdAt is string;
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // User online presence and active feature tracking
    match /userPresence/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidPresence(incoming());
      allow delete: if isAdmin();
    }

    // Feature interactions log for admin usage and analytics
    match /featureInteractions/{interactionId} {
      allow read: if true;
      allow create: if isValidId(interactionId) && isValidFeatureInteraction(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
