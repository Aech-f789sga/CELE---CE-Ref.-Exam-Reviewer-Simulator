rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isDesignatedAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'derrickdarrack@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isDesignatedAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             data.role in ['admin', 'user'] &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidExamAttempt(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.subject in ['MSTC', 'HPGE', 'PSAD'] &&
             data.year is number &&
             data.score is number &&
             data.totalQuestions is number &&
             data.ratingPercentage is number &&
             data.completedAt is string && data.completedAt.size() <= 64;
    }

    function isValidAnnouncement(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 2000 &&
             data.authorEmail is string && data.authorEmail.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.isActive is bool;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && (
        (incoming().role == 'user' && !isDesignatedAdminEmail()) ||
        (incoming().role == 'admin' && isDesignatedAdminEmail()) ||
        isAdmin()
      );
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && isValidUser(incoming()) && incoming().role == existing().role)
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admins marker collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && isDesignatedAdminEmail())
      );
      allow delete: if isValidId(userId) && isAdmin() && !isDesignatedAdminEmail();
    }

    // Exam attempts collection
    match /examAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(attemptId) && isSignedIn() && isValidExamAttempt(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if isValidId(attemptId) && isAdmin();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming());
      allow delete: if isValidId(announcementId) && isAdmin();
    }
  }
}
