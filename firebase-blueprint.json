{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control (Admin or User).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier of the user (Firebase Auth UID)." },
        "email": { "type": "string", "format": "email", "description": "User email address." },
        "displayName": { "type": "string", "description": "Display name of the user." },
        "photoURL": { "type": "string", "description": "Avatar photo URL of the user." },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User role: admin or standard user." },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation." },
        "lastLoginAt": { "type": "string", "description": "ISO timestamp of last login." },
        "lastUsernameChangedAt": { "type": "string", "description": "ISO timestamp when username was last modified (restricted to once per week)." }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Marker document establishing trusted admin role in Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID of the admin user." },
        "email": { "type": "string", "format": "email", "description": "Email of the admin user." },
        "grantedAt": { "type": "string", "description": "ISO timestamp when admin role was granted." }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "ExamAttempt": {
      "title": "ExamAttempt",
      "description": "Persistent record of an exam attempt taken by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Attempt unique ID." },
        "userId": { "type": "string", "description": "UID of the user who took the exam." },
        "userEmail": { "type": "string", "description": "Email of the user." },
        "subject": { "type": "string", "enum": ["MSTC", "HPGE", "PSAD"], "description": "Exam subject area." },
        "year": { "type": "number", "description": "Exam year." },
        "month": { "type": "string", "enum": ["April", "November"], "description": "Exam month." },
        "score": { "type": "number", "description": "Correct answers score." },
        "totalQuestions": { "type": "number", "description": "Total number of questions." },
        "ratingPercentage": { "type": "number", "description": "Percentage rating." },
        "passedArea": { "type": "boolean", "description": "Whether user met 50% threshold." },
        "timeSpentSeconds": { "type": "number", "description": "Time spent taking the exam in seconds." },
        "timerMode": { "type": "string", "description": "Timer mode used." },
        "completedAt": { "type": "string", "description": "ISO timestamp when completed." }
      },
      "required": ["id", "userId", "subject", "year", "month", "score", "totalQuestions", "ratingPercentage", "completedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "System announcement or exam bulletin published by admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique announcement ID." },
        "title": { "type": "string", "description": "Announcement title." },
        "message": { "type": "string", "description": "Announcement message content." },
        "authorEmail": { "type": "string", "description": "Email of the publishing admin." },
        "createdAt": { "type": "string", "description": "ISO timestamp of publication." },
        "isActive": { "type": "boolean", "description": "Active status of the announcement." }
      },
      "required": ["id", "title", "message", "authorEmail", "createdAt", "isActive"]
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Real-time user presence and active feature status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique user ID." },
        "email": { "type": "string", "format": "email", "description": "User email." },
        "displayName": { "type": "string", "description": "User display name." },
        "lastSeenAt": { "type": "string", "description": "ISO timestamp of last activity." },
        "currentFeature": { "type": "string", "description": "Current active feature being used." },
        "isOnline": { "type": "boolean", "description": "Whether the user is currently online." }
      },
      "required": ["userId", "lastSeenAt", "isOnline"]
    },
    "FeatureInteraction": {
      "title": "FeatureInteraction",
      "description": "Log record of user feature interaction with duration and timestamp.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique log record ID." },
        "userId": { "type": "string", "description": "User ID who interacted with the feature." },
        "userEmail": { "type": "string", "description": "User email address." },
        "userDisplayName": { "type": "string", "description": "User display name." },
        "featureId": { "type": "string", "description": "Feature identifier key." },
        "featureName": { "type": "string", "description": "Human-readable feature name." },
        "startTime": { "type": "string", "description": "ISO timestamp when interaction started." },
        "endTime": { "type": "string", "description": "ISO timestamp when interaction ended." },
        "durationSeconds": { "type": "number", "description": "Duration spent in seconds." },
        "metadata": { "type": "string", "description": "Optional context details." },
        "createdAt": { "type": "string", "description": "Creation timestamp." }
      },
      "required": ["id", "userId", "featureId", "featureName", "durationSeconds", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "entities/User" },
      "description": "User profiles indexed by UID. Users can read/write their own record (cannot escalate role), admin can read all."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "entities/AdminRecord" },
      "description": "Admin identity markers. Only verified admins can read/write."
    },
    "/examAttempts/{attemptId}": {
      "schema": { "$ref": "entities/ExamAttempt" },
      "description": "Exam attempts records. Users can read/create their own attempts, admin can read all."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "entities/Announcement" },
      "description": "System announcements. All signed in users can read, only admins can create/update/delete."
    },
    "/userPresence/{userId}": {
      "schema": { "$ref": "entities/UserPresence" },
      "description": "User online presence and heartbeat status. Users update their own, admin can read all."
    },
    "/featureInteractions/{interactionId}": {
      "schema": { "$ref": "entities/FeatureInteraction" },
      "description": "Feature interaction history and durations. Users log interactions, admin can read all for analytics."
    }
  }
}
